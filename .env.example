# Never prefix server credentials with VITE_. Never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
PASSKEY_ORIGIN=https://my-webpage-passkeys.vercel.app
PASSKEY_RP_ID=my-webpage-passkeys.vercel.app
# Optional: comma-separated extra HTTP loopback origins, development only.
# PASSKEY_DEV_ORIGINS=http://localhost:4175,http://127.0.0.1:4175

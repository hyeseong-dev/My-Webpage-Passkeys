{
  "name": "my-webpage-passkeys",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/passkeys-migrate.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test server/passkeys/handler.test.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "express": "4.22.2",
    "lucide-react": "0.453.0",
    "pg": "8.23.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.0",
      "path-to-regexp": "0.1.13"
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.1.14",
    "@types/express": "4.17.21",
    "@types/node": "24.7.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.10",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.6.3",
    "vite": "7.1.9",
    "vitest": "2.1.9"
  }
}
